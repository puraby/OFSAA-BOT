# --- API & CORS ---
ALLOW_ORIGINS=http://localhost:8501

# --- Demo mode (no DB needed). Set to 1 to use mock data everywhere. ---
DEMO_MODE=1

# --- Oracle (only needed when DEMO_MODE is unset/absent) ---
ORA_DSN=HOST=localhost;PORT=1521;SERVICE_NAME=FREEPDB1
ORA_USER=
ORA_PASS=

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM settings (LiteLLM) ---
LLM_MODEL=gpt-4o-mini        # e.g., gpt-4o-mini, anthropic/claude-3-haiku, google/gemini-1.5-flash, ollama/llama3
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# Choose the right key for provider (only one typically needed):
OPENAI_API_KEY=replace_me
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AZURE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434  # for local models
